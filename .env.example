# Semua variabel di bawah OPSIONAL. Aplikasi sudah punya nilai default.
# Atur lewat Vercel > Project > Settings > Environment Variables.

# Project ID Firebase untuk verifikasi token admin (default: neon-ripsaw-c8p5g)
FIREBASE_PROJECT_ID=""

# Email pemilik yang boleh akses admin, dipisah koma. Email pertama = primary owner.
# Contoh: OWNER_EMAILS="owner1@gmail.com,owner2@gmail.com"
OWNER_EMAILS=""
